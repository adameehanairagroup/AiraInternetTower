config wifi-device 'radio0'
	option type 'mac80211'
	option channel '36'
	option band '5g'
	option htmode 'VHT80'
	option country 'IN'
	option disabled '0'

config wifi-iface 'mesh0'
	option device 'radio0'
	option mode 'mesh'
	option mesh_id 'community-mesh'
	option encryption 'sae'
	option key 'CHANGE_ME_LONG_PASSPHRASE'
	option mesh_fwding '0'
	option network 'bat0_hardif'
	option ifname 'mesh0'

config wifi-device 'radio1'
	option type 'mac80211'
	option channel '6'
	option band '2g'
	option country 'IN'

config wifi-iface 'ap0'
	option device 'radio1'
	option mode 'ap'
	option ssid 'Community-WiFi'
	option encryption 'psk2'
	option key 'CHANGE_ME_ACCESS_KEY'
	option network 'lan'
